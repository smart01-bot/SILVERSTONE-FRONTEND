{
  "expo": {
    "name": "Swift Wakala",
    "slug": "silverstone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF0F2",
    "icon": "./assets/images/swift-wakala-icon.png",
    "splash": {
      "backgroundColor": "#EEF0F2",
      "resizeMode": "contain"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/swift-wakala-adaptive.png",
        "backgroundColor": "#FFFFFF",
        "monochromeImage": "./assets/images/swift-wakala-adaptive.png"
      },
      "package": "com.silverstone.floatmanager",
      "versionCode": 2,
      "splash": {
        "backgroundColor": "#EEF0F2",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.silverstone.floatmanager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "backgroundColor": "#EEF0F2",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    },
    "plugins": [
      "expo-system-ui",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "bde2a248-8bd8-4716-984f-41ca5a9a93e9"
      }
    },
    "owner": "silverstone05s-organization"
  }
}
