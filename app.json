{
  "expo": {
    "name": "Silverstone",
    "slug": "silverstone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/SilverS.png",
    "splash": {
      "backgroundColor": "#EEF0F2",
      "resizeMode": "contain"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/SilverS.png",
        "backgroundColor": "#D32F2F"
      },
      "package": "com.silverstone.floatmanager",
      "versionCode": 2,
      "splash": {
        "backgroundColor": "#EEF0F2",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    },
    "ios": {
      "bundleIdentifier": "com.silverstone.floatmanager",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "splash": {
        "backgroundColor": "#EEF0F2",
        "resizeMode": "contain",
        "dark": {
          "backgroundColor": "#000000"
        }
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#D32F2F"
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "eas": {
        "projectId": "bde2a248-8bd8-4716-984f-41ca5a9a93e9"
      }
    },
    "owner": "silverstone05s-organization"
  }
}
