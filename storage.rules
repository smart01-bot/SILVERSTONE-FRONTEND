rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Agent documents — only the owning agent can write,
    // any authenticated user (e.g. main agent reviewing) can read
    match /agents/{uid}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read:  if request.auth != null;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
